# SplitSphere Environment Variables Configuration
# Copy this file to .env before starting the production or docker environment

# Application Port
PORT=3000

# App Hosting URL
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://splitsphere:splitsphere_pass@localhost:5432/splitspheredb?schema=public"

# Redis Cache Service Connection URL
REDIS_URL="redis://localhost:6379"

# Cryptographic JWT Secret Keys (Must be >= 32 characters in production)
JWT_SECRET="splitsphere-super-secret-jwt-key-2026-production-grade"
JWT_REFRESH_SECRET="splitsphere-super-secret-refresh-key-2026-production-grade"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"

# Optional Gemini API Key (Server-Side Proxy)
GEMINI_API_KEY=""
